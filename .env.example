# Garmin Connect credentials
GARMIN_USERNAME=
GARMIN_PASSWORD=
GARMIN_SESSION_STORAGE_PATH=.garmin/tokens
REDACT_PII=true

# Generative AI inference
GENAI_API_KEY=
REGION=
OCI_MODEL_ID=openai.gpt-5.4

# Local service URLs
ASSISTANT_API_URL=http://localhost:8000
ASSISTANT_API_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO
