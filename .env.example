# Garmin Connect access
GARMIN_USERNAME=
GARMIN_PASSWORD=
GARMIN_SESSION_STORAGE_PATH=.garmin/tokens
GARMIN_CREDENTIAL_ENCRYPTION_KEY=
GARMIN_SESSION_STORAGE_ROOT=/data/garmin-sessions
REDACT_PII=true
GARMIN_COMPACT_ACTIVITY_PAYLOAD=false

# OCI Enterprise AI inference
GENAI_API_KEY=
REGION=
OCI_MODEL_ID=openai.gpt-5.4

# Local MySQL persistence
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=garmin_ai_coach
MYSQL_USER=garmin_coach
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
MYSQL_DATA_DIR=./data/mysql

# Local service URLs and ports
ASSISTANT_API_URL=http://localhost:8000
# Optional fallback used by frontend route handlers in non-Docker experiments.
NEXT_PUBLIC_ASSISTANT_API_URL=http://localhost:8000
# Docker Compose exposes nginx on this port; nginx proxies the frontend and
# forwards authenticated requests to internal services.
FRONTEND_PORT=3000

# Logging
LOG_LEVEL=INFO
